# Industry Iceberg - SEO Optimization & SPA Routing Configuration
# Ensures React Router works correctly on refresh + handles canonical redirects

# Enable rewrite engine
RewriteEngine On

# Force HTTPS redirection
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Disable MultiViews to prevent Apache from guessing file paths
Options -MultiViews

# Don't apply rewrite rules to actual files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Compliance Loop Product Routes
RewriteRule ^complianceloop/?$ /index.html [L]
RewriteRule ^complianceloop/services/?$ /index.html [L]
RewriteRule ^complianceloop/services/([^/]+)/?$ /index.html [L]
RewriteRule ^complianceloop/demo/?$ /index.html [L]

# VeritaScribe Product Routes
RewriteRule ^veritascribe/?$ /index.html [L]
RewriteRule ^veritascribe/templates/?$ /index.html [L]
RewriteRule ^veritascribe/pricing/?$ /index.html [L]
RewriteRule ^veritascribe/demo/?$ /index.html [L]

# Complisense Product Routes
RewriteRule ^complisense/?$ /index.html [L]
RewriteRule ^complisense/services/?$ /index.html [L]
RewriteRule ^complisense/services/([^/]+)/?$ /index.html [L]
RewriteRule ^complisense/demo/?$ /index.html [L]

# Remove trailing slashes and redirect
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# SPA Fallback - Handle all other routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# 404 Error Document (only for actual 404s that aren't handled by rewrites)
ErrorDocument 404 /404.html

# Legacy page redirects (from old hyphenated URLs to new format)
RewriteRule ^about-us/?$ /about [L,R=301]
RewriteRule ^contact-us/?$ /contact [L,R=301]
RewriteRule ^our-services/?$ /complianceloop/services [L,R=301]
RewriteRule ^complianceloop/?$ /complianceloop [L,R=301]
RewriteRule ^complianceloop/services/?$ /complianceloop/services [L,R=301]
RewriteRule ^complianceloop/demo/?$ /complianceloop/demo [L,R=301]
RewriteRule ^complianceloop/services/cmo/?$ /complianceloop/services/CMO [L,R=301]
RewriteRule ^complianceloop/services/cdmo/?$ /complianceloop/services/CDMO [L,R=301]
RewriteRule ^complianceloop/services/cro/?$ /complianceloop/services/CROs [L,R=301]
RewriteRule ^complianceloop/services/preclinical/?$ /complianceloop/services/pre-clinical [L,R=301]

# Custom error pages
# 404 handled above with proper positioning

# Handle React Router - redirect all requests to index.html
# Except for actual files and directories that exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # SEO headers
    Header always set X-Canonical "https://www.industryiceberg.com"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    ExpiresByType image/svg "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow CORS for API requests (if needed)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
